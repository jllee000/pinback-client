{
  "name": "pinback-client",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "lint:fix": "pnpm --filter client lint --fix && pnpm --filter extension lint --fix && pnpm --filter landing lint --fix",
    "fix-all": "pnpm format && pnpm lint:fix",
    "check-all": "pnpm format && pnpm lint:fix && pnpm build",
    "preview": "turbo run preview"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "turbo": "^2.5.4",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
