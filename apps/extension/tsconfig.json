{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "outDir": "./dist/",
    "sourceMap": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "module": "esnext",
    "target": "es2015",
    "lib": ["es2015", "dom", "dom.iterable"],
    "allowJs": true,
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "plugins": [{ "name": "react" }],
    "incremental": false,
    // 절대 경로 설정
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@pages/*": ["src/pages/*"]
    }
  },
  "include": ["./src/**/*", "src/custom.d.ts", "vite.config.ts"]
}
