{
  "extends": "@pinback/typescript/react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [{ "name": "react" }],
    "incremental": false,
    "paths": {
      "@/*": ["src/*"],
      "@shared": ["src/shared"],
      "@shared/*": ["src/shared/*"],
      "@pages": ["src/pages"],
      "@pages/*": ["src/pages/*"],
      "@routes": ["src/routes"],
      "@routes/*": ["src/routes/*"],
      "@constants/*": ["src/constants/*"],
      "@assets": ["src/assets"],
      "@assets/*": [
        "src/assets/*",
        "src/pages/dashboard/assets/*"
      ]
    }
  },
  "include": ["src", "vite.config.ts", "public/firebase-messaging-sw.js"],
  "types": ["chrome"],
  "exclude": ["node_modules", "../../.cursorrules"]
}
